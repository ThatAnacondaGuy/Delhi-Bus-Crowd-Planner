# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environments
.env
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Operating System & IDE metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Large Raw Datasets & Binary Pipeline Artifacts
*.csv
*.zip
*.tar.gz
*.db
*.sqlite
*.sqlite3

# Specific Data Directory Rules
data/raw/*
!data/raw/.gitkeep

# Generated data and binary artifacts
data/processed_/
*.parquet
*.pkl
*.geojson
*.7z
*.duckdb
data/processed/*

# Re-includes (must stay after the patterns above)
!data/processed/*.json
!data/processed/*.md
!data/processed/*.csv
# local-only outputs: absolute paths in the hash cache, 4 MB pipeline CSV
data/processed/manifest.json
data/processed/route_hour_summary.csv
# installers dropped in the repo root
*.dmg
!data/gps_aggregates/**
!tests/fixtures/**

# Binary artifacts stay ignored even inside the re-included directories
tests/fixtures/**/*.parquet
tests/fixtures/**/*.pkl
tests/fixtures/**/*.geojson
tests/fixtures/**/*.7z
tests/fixtures/**/*.db
tests/fixtures/**/*.duckdb
data/gps_aggregates/**/*.parquet
data/gps_aggregates/**/*.pkl
data/gps_aggregates/**/*.geojson
data/gps_aggregates/**/*.7z
data/gps_aggregates/**/*.db
data/gps_aggregates/**/*.duckdb

# Demo film (video/): dependencies, renders and user-supplied media are never committed
video/node_modules/
video/out/
video/public/vo/
video/public/music*
video/public/sfx/
video/public/clips/
video/public/captures/
video/public/assets.json
video/extra resources/
