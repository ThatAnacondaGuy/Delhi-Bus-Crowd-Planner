data/raw/*
!data/raw/.gitkeep

# Generated data and binary artifacts
data/processed_/
*.parquet
*.pkl
*.geojson
*.7z
*.duckdb
data/processed/*

# Re-includes (must stay after the patterns above)
!data/processed/*.json
!data/processed/*.md
!data/processed/*.csv
!data/gps_aggregates/**
!tests/fixtures/**
